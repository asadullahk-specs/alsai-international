# Server
PORT=5000
NODE_ENV=development

# MongoDB — Atlas connection string, must include your database name in the path
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/al_sai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/al_sai

# Frontend origin (for CORS + links in emails)
CLIENT_URL=http://localhost:5173

# JWT — generate real random values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_CUSTOMER_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ADMIN_ACCESS_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_EXPIRY=15m

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# Outgoing email (optional for local dev — without it, emails are logged to the console instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AL SA'I
EMAIL_FROM_ADDRESS=no-reply@alsai.com

# First Super Admin created by `npm run seed` (optional — sensible defaults are used if omitted)
ADMIN_SEED_EMAIL=admin@alsai.com
ADMIN_SEED_PASSWORD=ChangeMe123!
